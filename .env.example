# ==============================================================================
# WhatsApp Server Environment Configuration
# ==============================================================================

# Port on which the HTTP server will listen (Default: 3000)
PORT=3000

# Node execution environment (development | production | test)
NODE_ENV=development

# MongoDB Connection String (Required)
# Format: mongodb://[username:password@]host[:port]/[database][?options]
# Example: mongodb://localhost:27017/whatsapp-server
# Example for Docker Compose: mongodb://mongo:27017/whatsapp-server
MONGODB_URL=mongodb://localhost:27017/whatsapp-server

# Secret key used for signing and verifying user session JWT cookies (Required)
# Generate a secure 64-character random string (e.g., using `openssl rand -hex 32`)
JWT_SECRET=your_jwt_secret_key_change_me_in_production
